{
  "name": "@local/dsh-token-spend",
  "version": "1.0.0",
  "displayName": "花费",
  "description": "Token spend ledger settings page: daily all-in token usage heatmap, cache efficiency, usage composition, and per-day session detail. Duplicated model calls are merged by message id, and a durable day ledger keeps recorded usage after a session is deleted.",
  "type": "module",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-bundle",
    "cordis",
    "tokens",
    "usage",
    "spend",
    "settings"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaobaga281/dsh-token-spend.git"
  },
  "homepage": "https://github.com/xiaobaga281/dsh-token-spend#readme",
  "bugs": {
    "url": "https://github.com/xiaobaga281/dsh-token-spend/issues"
  },
  "author": "xiaobaga281",
  "engines": {
    "node": ">=20"
  }
}
